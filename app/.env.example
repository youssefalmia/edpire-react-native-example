# Optional. Copy to .env only if you need to override a default, then restart
# `npx expo start`. Expo reads these when it builds the bundle, so a reload is
# not enough.
#
# Nothing secret belongs in this file. Everything prefixed EXPO_PUBLIC_ is
# embedded in the app bundle and can be read by anyone who downloads the app.
# Your Edpire API key goes in server/.env instead.
#
# There is no assessment ID here on purpose. The app asks your server which
# assessments are published and lists them by title, so nobody ever pastes an
# Edpire UUID.

# Where your token server lives.
# Leave this unset in development: the app derives it from the Expo dev server's
# own address, which is already correct for both a device and an emulator.
# EXPO_PUBLIC_TOKEN_SERVER=https://api.yourapp.com

# Which Edpire the player talks to. Leave unset for production (edpire.com).
# EXPO_PUBLIC_EDPIRE_BASE_URL=https://staging.edpire.com

# The assessment's own language, which decides text direction: en, fr or ar.
# EXPO_PUBLIC_LOCALE=en
