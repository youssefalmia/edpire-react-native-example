# Secrets. The API key must never be committed: this repo is public, and a
# leaked key lets anyone mint tokens against your org.
.env
.env.*
!.env.example

# Node
node_modules/
npm-debug.log*
yarn-error.log*

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native projects, when generated by `expo prebuild`. They are derived from
# app.json, so committing them invites the two to drift apart.
/app/ios/
/app/android/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.tsbuildinfo
